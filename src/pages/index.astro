---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const essays = (await getCollection('essays')).sort((a, b) =>
  new Date(b.data.pubDate ?? 0).valueOf() - new Date(a.data.pubDate ?? 0).valueOf(),
);
---

<BaseLayout title="Prismary" description="Prismary is a minimal home for essays and notes.">
  <main class="container directory-wrap">
    <ul class="index-list">
      {essays.map((essay) => (
        <li>
          <div class="thumb" aria-hidden="true">
            {essay.data.thumbnail ? <img src={essay.data.thumbnail} alt={essay.data.title} /> : null}
          </div>
          <a href={`/essays/${essay.slug}/`}>{essay.data.title}</a>
          <span>{essay.data.description}</span>
        </li>
      ))}
      <li>
        <div class="thumb" aria-hidden="true">
          <img src="/media/aif_gym_thumb.png" alt="Active Inference Gym thumbnail" />
        </div>
        <a href="https://micstn.github.io/active_inference_gym/" target="_blank" rel="noreferrer noopener">Active Inference Gym</a>
        <span>Interactive simulations and experiments exploring active inference, embodied learning, and model-based behavior.</span>
      </li>
      <li>
        <div class="thumb" aria-hidden="true">
          <img src="/media/mountain_car_thumb.png" alt="Continuous MountainCar thumbnail" />
        </div>
        <a href="https://micstn.github.io/actinf_gssm_catal2/" target="_blank" rel="noreferrer noopener">Active Inference Control Experiment: Continuous MountainCar</a>
        <span>Research-led visual and computational notes on structured inference systems, model design, and exploratory analysis.</span>
      </li>
    </ul>

    <section id="about" class="about-block">
      <p>
        Prismary is a minimal home for essays, notes, and visual writing on how minds, artificial and otherwise,
        come to be. I'm interested in probabilistic approaches to machine intelligences and developing autonomous
        agents pursuing goals in complex environments. I like active inference lens to generative models as well
        as collective and genetic algorithms.
      </p>
    </section>
  </main>
</BaseLayout>
