---
import '../styles/global.css';

const {
  title = 'Prismary',
  description = 'Prismary is a directory of essays and notes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="topbar">
      <div class="container nav">
        <a class="brand" href="/" aria-label="Prismary home">
          <img class="brand-mark" src="/media/prismary.jpg" alt="Prismary mark" />
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/essays/">Essays</a>
          <a href="/#about">About</a>
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>
